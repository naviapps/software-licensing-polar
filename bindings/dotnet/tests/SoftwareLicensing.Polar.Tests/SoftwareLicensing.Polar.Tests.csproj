<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NaviApps.SoftwareLicensing.Polar/NaviApps.SoftwareLicensing.Polar.csproj" />
    <None Include="$(PolarNativeLibrary)" Condition="'$(PolarNativeLibrary)' != ''" CopyToOutputDirectory="Always">
      <Link Condition="'$(OS)' == 'Windows_NT'">software_licensing_polar.dll</Link>
      <Link Condition="'$(OS)' != 'Windows_NT'">libsoftware_licensing_polar.dylib</Link>
    </None>
    <None Include="$(SoftwareLicensingNativeLibrary)" Condition="'$(SoftwareLicensingNativeLibrary)' != ''" CopyToOutputDirectory="Always">
      <Link Condition="'$(OS)' == 'Windows_NT'">software_licensing.dll</Link>
      <Link Condition="'$(OS)' != 'Windows_NT'">libsoftware_licensing.dylib</Link>
    </None>
  </ItemGroup>
</Project>
