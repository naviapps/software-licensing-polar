<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>NaviApps.SoftwareLicensing.Polar</PackageId>
    <Version>0.1.0</Version>
    <Description>Rust-owned Polar License API provider for NaviApps.SoftwareLicensing.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/software-licensing-polar/dotnet</PathMap>
    <PolarNativeLibrary Condition="'$(PolarNativeLibrary)' == ''">../../runtimes/$(PolarRuntimeIdentifier)/native/$(PolarNativeFileName)</PolarNativeLibrary>
  </PropertyGroup>
  <Import Project="../../../../build/bindings/core.props" Condition="Exists('../../../../build/bindings/core.props')" />
  <ItemGroup>
    <ProjectReference Include="$(SoftwareLicensingProject)" Condition="'$(SoftwareLicensingProject)' != ''" />
    <None Include="../../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="$(PolarNativeLibrary)" Condition="'$(PolarRuntimeIdentifier)' != '' and '$(PolarNativeFileName)' != ''" Pack="true" PackagePath="runtimes/$(PolarRuntimeIdentifier)/native/$(PolarNativeFileName)" />
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../../ThirdParty/**/*" Exclude="../../../../ThirdParty/**/.DS_Store;../../../../ThirdParty/**/registry-notices.json" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
  <Target Name="RequireSoftwareLicensingSource" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(SoftwareLicensingProject)' == ''" Text="Run python3 -B -m fixtures.distribution.bindings --prepare-dotnet from the repository root to resolve the pinned core SDK, or set SoftwareLicensingProject explicitly for coordinated development." />
    <Error Condition="'$(SoftwareLicensingProject)' != '' and !Exists('$(SoftwareLicensingProject)')" Text="Resolved core project is missing. Run python3 -B -m fixtures.distribution.bindings --prepare-dotnet again." />
  </Target>
  <Target Name="RequirePolarNativeAsset" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(PolarRuntimeIdentifier)' == '' or '$(PolarNativeFileName)' == ''" Text="Use the platform packaging tool with a source-built Polar native library." />
    <Error Condition="!Exists('$(PolarNativeLibrary)')" Text="The source-built Polar native library is missing." />
  </Target>
</Project>
